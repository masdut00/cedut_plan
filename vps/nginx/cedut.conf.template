# Nginx host config untuk dashboard Mas & Cece Wedding Saving.
# Dibuat oleh vps/setup-domain.sh — __DOMAIN__ diganti otomatis.
# SSL (listen 443) ditambahkan otomatis oleh certbot --nginx.

# ---------- Dashboard: tabungan.__DOMAIN__ ----------
server {
    listen 80;
    listen [::]:80;
    server_name tabungan.__DOMAIN__;

    auth_basic "Tabungan Mas & Cece";
    auth_basic_user_file /etc/nginx/cedut.htpasswd;

    location / {
        proxy_pass http://127.0.0.1:__WEB_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
