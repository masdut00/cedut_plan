# Salin file ini menjadi .env lalu isi nilainya:  cp .env.example .env
# JANGAN commit file .env ke git.

# ---------- Jaringan ----------
# 0.0.0.0 = port 5678/8080 terbuka ke internet; 127.0.0.1 = hanya lokal (akses via SSH tunnel / reverse proxy)
BIND_ADDRESS=0.0.0.0

# ---------- n8n ----------
N8N_VERSION=latest
# Domain atau IP VPS, mis. n8n.domainanda.com atau 203.0.113.10
N8N_HOST=203.0.113.10
N8N_PROTOCOL=http
# URL publik n8n (dipakai untuk menampilkan URL webhook di UI)
N8N_WEBHOOK_URL=http://203.0.113.10:5678/
# Set true jika n8n diakses lewat HTTPS
N8N_SECURE_COOKIE=false
# String acak panjang. Buat dengan: openssl rand -hex 32
N8N_ENCRYPTION_KEY=ganti-dengan-string-acak-panjang

# ---------- Evolution API (WhatsApp Gateway) ----------
EVOLUTION_VERSION=v2.2.3
# URL publik Evolution API, mis. http://203.0.113.10:8080
EVOLUTION_SERVER_URL=http://203.0.113.10:8080
# API key global Evolution. Buat dengan: openssl rand -hex 24
EVOLUTION_API_KEY=ganti-dengan-api-key-acak
# Nama instance WhatsApp yang akan dibuat di Evolution Manager
EVOLUTION_INSTANCE=wedding-bot
# Password database Postgres untuk Evolution API
POSTGRES_PASSWORD=ganti-dengan-password-kuat

# ---------- AI (Google Gemini) ----------
# API key gratis dari https://aistudio.google.com/app/apikey
GEMINI_API_KEY=isi-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ---------- Tabungan ----------
GOOGLE_SHEET_ID=1OoXCrAtdNQDTbkrABS2FVLOQJLP5KDBUoXv4IkcOEEQ
TARGET_AMOUNT=100000000

# Nomor WhatsApp yang diizinkan mencatat (format internasional tanpa +, mis. 6281234567890)
MAS_NUMBER=628xxxxxxxxxx
CECE_NUMBER=628xxxxxxxxxx
